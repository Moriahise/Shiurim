{
  "schema": 1,
  "rules_version": "1.0",
  "require_paragraph_mapping": true,
  "minimum_anchor_letters": 6,
  "semantic": {
    "enabled": true,
    "required_for_complete_preflight": true,
    "key_env": "SHIURIM_REVIEW_API_KEY",
    "model_env": "SHIURIM_REVIEW_MODEL",
    "max_calls_per_edition": 2,
    "max_input_characters": 85000,
    "max_output_tokens_per_call": 8000,
    "timeout_seconds": 45
  }
}
